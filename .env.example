# Copy this file to .env and fill in the values. The .env file is listed in .gitignore and is never
# committed. Each key is described in the Technical Reference, Part 2.

# SEC EDGAR requires a User-Agent with a name and contact email (Technical Reference, Part 2.2).
SEC_USER_AGENT="Your Name your.email@example.com"

# WRDS username (the password is stored by the wrds package in ~/.pgpass on first login).
WRDS_USERNAME=

# FRED / ALFRED API key (free from the St. Louis Fed).
FRED_API_KEY=

# congress.gov API key (free from api.data.gov).
CONGRESS_API_KEY=

# Interactive Brokers gateway (paper trading uses port 4002 by default).
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=7

# Optional sources
NEWSAPI_KEY=
